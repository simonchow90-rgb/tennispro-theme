<style>
/* ============================================
   Tennis Sportswear Store â€” Color Scheme
   Sense Theme Overrides
   Primary: #0B5E42  |  Accent: #F5C518
   ============================================ */

/* --- Global --- */
:root {
  --tennis-green: #0B5E42;
  --tennis-green-dark: #062D20;
  --tennis-green-light: #14855E;
  --tennis-accent: #F5C518;
  --tennis-accent-hover: #D4A800;
  --tennis-white: #FFFFFF;
  --tennis-bg-light: #F8F9FA;
  --tennis-text: #1A1A2E;
  --tennis-text-light: #6B7280;
  --tennis-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  --tennis-shadow-hover: 0 8px 24px rgba(0, 0, 0, 0.12);
  --tennis-radius: 8px;
  --tennis-transition: all 0.3s ease;
}

/* --- Header --- */
.site-header {
  background-color: var(--tennis-green) !important;
  border-bottom: none !important;
}

.site-header__logo a,
.site-header__logo a:hover {
  color: var(--tennis-white) !important;
}

.site-nav__link {
  color: var(--tennis-white) !important;
  opacity: 0.9;
  transition: var(--tennis-transition);
}

.site-nav__link:hover,
.site-nav__link:focus {
  color: var(--tennis-accent) !important;
  opacity: 1;
}

.site-nav--active .site-nav__link {
  color: var(--tennis-accent) !important;
  border-bottom: 2px solid var(--tennis-accent);
}

/* Header icons (cart, search, account) */
.site-header__icon {
  color: var(--tennis-white) !important;
  transition: var(--tennis-transition);
}

.site-header__icon:hover {
  color: var(--tennis-accent) !important;
}

/* Cart count badge */
.site-header__cart-count {
  background-color: var(--tennis-accent) !important;
  color: var(--tennis-green-dark) !important;
}

/* --- Buttons --- */
.btn,
.button,
.shopify-challenge__button,
.product-form__submit {
  background-color: var(--tennis-green) !important;
  color: var(--tennis-white) !important;
  border: 2px solid var(--tennis-green) !important;
  border-radius: var(--tennis-radius) !important;
  font-weight: 600 !important;
  padding: 12px 28px !important;
  transition: var(--tennis-transition) !important;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-size: 14px;
}

.btn:hover,
.button:hover,
.shopify-challenge__button:hover,
.product-form__submit:hover {
  background-color: var(--tennis-green-light) !important;
  border-color: var(--tennis-green-light) !important;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(11, 94, 66, 0.3);
}

.btn--secondary {
  background-color: transparent !important;
  color: var(--tennis-green) !important;
  border: 2px solid var(--tennis-green) !important;
}

.btn--secondary:hover {
  background-color: var(--tennis-green) !important;
  color: var(--tennis-white) !important;
}

.btn--accent {
  background-color: var(--tennis-accent) !important;
  color: var(--tennis-green-dark) !important;
  border-color: var(--tennis-accent) !important;
}

.btn--accent:hover {
  background-color: var(--tennis-accent-hover) !important;
  border-color: var(--tennis-accent-hover) !important;
}

/* --- Sale Badge --- */
.badge--sale,
.product-price__sale-label,
.sale-tag {
  background-color: var(--tennis-accent) !important;
  color: var(--tennis-green-dark) !important;
  font-weight: 700 !important;
  padding: 4px 12px !important;
  border-radius: 4px !important;
  font-size: 12px !important;
  text-transform: uppercase;
}

.badge--new {
  background-color: var(--tennis-green) !important;
  color: var(--tennis-white) !important;
  font-weight: 700 !important;
  padding: 4px 12px !important;
  border-radius: 4px !important;
  font-size: 12px !important;
  text-transform: uppercase;
}

/* --- Links --- */
a {
  color: var(--tennis-green);
  transition: var(--tennis-transition);
}

a:hover {
  color: var(--tennis-accent-hover);
}

/* --- Footer --- */
.site-footer {
  background-color: var(--tennis-green-dark) !important;
  color: var(--tennis-white) !important;
  border-top: 3px solid var(--tennis-accent);
}

.site-footer a {
  color: rgba(255, 255, 255, 0.8) !important;
}

.site-footer a:hover {
  color: var(--tennis-accent) !important;
}

.site-footer__title {
  color: var(--tennis-white) !important;
  border-bottom: 2px solid var(--tennis-accent);
  padding-bottom: 8px;
  display: inline-block;
}

/* --- Section Headings --- */
.section-header__title {
  color: var(--tennis-green-dark);
  position: relative;
  display: inline-block;
}

.section-header__title::after {
  content: '';
  display: block;
  width: 60px;
  height: 3px;
  background: var(--tennis-accent);
  margin: 8px auto 0;
}

/* --- Newsletter --- */
.newsletter-section {
  background-color: var(--tennis-bg-light) !important;
}

.newsletter__input {
  border: 2px solid var(--tennis-green) !important;
  border-radius: var(--tennis-radius) !important;
}

/* --- Breadcrumbs --- */
.breadcrumb {
  color: var(--tennis-text-light);
}

.breadcrumb a {
  color: var(--tennis-green);
}

.breadcrumb a:hover {
  color: var(--tennis-accent-hover);
}

/* --- Pagination --- */
.pagination__item--current {
  background-color: var(--tennis-green) !important;
  color: var(--tennis-white) !important;
  border-color: var(--tennis-green) !important;
}

.pagination__item:hover {
  color: var(--tennis-accent) !important;
}

/* --- Cart page --- */
.cart__checkout {
  background-color: var(--tennis-green) !important;
}

.cart__checkout:hover {
  background-color: var(--tennis-green-light) !important;
}

/* --- Drawer / Mobile Menu --- */
.drawer {
  background-color: var(--tennis-white);
}

.drawer__nav-link {
  color: var(--tennis-green-dark) !important;
  border-bottom: 1px solid rgba(11, 94, 66, 0.1);
}

.drawer__nav-link:hover {
  color: var(--tennis-accent-hover) !important;
}

/* --- Selected / Active states --- */
input:checked + .pill,
.active-filter {
  background-color: var(--tennis-green) !important;
  color: var(--tennis-white) !important;
  border-color: var(--tennis-green) !important;
}

/* --- Announcement bar --- */
.announcement-bar {
  background-color: var(--tennis-green-dark) !important;
  color: var(--tennis-white) !important;
}

.announcement-bar__message {
  color: var(--tennis-accent) !important;
  font-weight: 600;
}
/* ============================================
   Tennis Sportswear Store â€” Product Card Styles
   Sense Theme Enhancements
   ============================================ */

/* --- Product Card Container --- */
.product-card {
  background: #FFFFFF;
  border-radius: var(--tennis-radius, 8px);
  box-shadow: var(--tennis-shadow, 0 2px 8px rgba(0,0,0,0.08));
  overflow: hidden;
  transition: var(--tennis-transition, all 0.3s ease);
  position: relative;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--tennis-shadow-hover, 0 8px 24px rgba(0,0,0,0.12));
}

/* --- Product Image --- */
.product-card__image-wrapper {
  overflow: hidden;
  position: relative;
}

.product-card__image {
  transition: transform 0.5s ease;
  width: 100%;
  display: block;
}

.product-card:hover .product-card__image {
  transform: scale(1.05);
}

/* --- Badge Positioning --- */
.product-card__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
}

.product-card__badge--sale {
  background-color: var(--tennis-accent, #F5C518);
  color: var(--tennis-green-dark, #062D20);
  font-weight: 700;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.product-card__badge--new {
  background-color: var(--tennis-green, #0B5E42);
  color: #FFFFFF;
  font-weight: 700;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* --- Product Info --- */
.product-card__info {
  padding: 16px;
}

.product-card__vendor {
  font-size: 12px;
  color: var(--tennis-text-light, #6B7280);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 4px;
}

.product-card__title {
  font-size: 16px;
  font-weight: 600;
  color: var(--tennis-text, #1A1A2E);
  margin-bottom: 8px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-card__title a {
  color: inherit;
  text-decoration: none;
}

.product-card__title a:hover {
  color: var(--tennis-green, #0B5E42);
}

/* --- Price Styling --- */
.product-card__price {
  font-size: 18px;
  font-weight: 700;
  color: var(--tennis-green, #0B5E42);
  margin-bottom: 12px;
}

.product-card__price--sale {
  color: #DC2626;
}

.product-card__price--compare {
  font-size: 14px;
  font-weight: 400;
  color: #9CA3AF;
  text-decoration: line-through;
  margin-left: 8px;
}

/* --- Color Swatches (if used) --- */
.product-card__swatches {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
}

.product-card__swatch {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #E5E7EB;
  cursor: pointer;
  transition: var(--tennis-transition, all 0.3s ease);
}

.product-card__swatch:hover,
.product-card__swatch--active {
  border-color: var(--tennis-green, #0B5E42);
  transform: scale(1.15);
}

/* --- Quick Add Button --- */
.product-card__quick-add {
  width: 100%;
  padding: 12px 16px;
  background-color: var(--tennis-green, #0B5E42);
  color: #FFFFFF;
  border: none;
  border-radius: var(--tennis-radius, 8px);
  font-weight: 600;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: var(--tennis-transition, all 0.3s ease);
  opacity: 0;
  transform: translateY(4px);
}

.product-card:hover .product-card__quick-add {
  opacity: 1;
  transform: translateY(0);
}

.product-card__quick-add:hover {
  background-color: var(--tennis-green-light, #14855E);
  box-shadow: 0 4px 12px rgba(11, 94, 66, 0.3);
}

/* --- Product Card Grid (Sense compatibility) --- */
.grid--uniform .grid__item {
  margin-bottom: 24px;
}

/* --- Quick Add for Mobile (always visible) --- */
@media screen and (max-width: 768px) {
  .product-card__quick-add {
    opacity: 1;
    transform: none;
  }

  .product-card:hover {
    transform: none;
  }
}

/* --- Featured Collection Section --- */
.featured-collection .product-card {
  margin-bottom: 0;
}

/* --- Rating Stars (placeholder) --- */
.product-card__rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 8px;
}

.product-card__star {
  color: var(--tennis-accent, #F5C518);
  font-size: 14px;
}

.product-card__review-count {
  font-size: 12px;
  color: var(--tennis-text-light, #6B7280);
  margin-left: 4px;
}
/* ============================================
   Tennis Sportswear Store â€” Mobile Fixes
   Sense Theme Responsive Overrides
   ============================================ */

/* --- Hamburger Menu --- */
.drawer--left .drawer__header {
  background-color: var(--tennis-green, #0B5E42);
  padding: 16px 20px;
}

.drawer--left .drawer__close-button {
  color: #FFFFFF !important;
  font-size: 24px;
}

.drawer--left .drawer__inner {
  background-color: #FFFFFF;
}

.drawer--left .drawer__nav {
  padding: 8px 0;
}

.drawer--left .drawer__nav-item {
  border-bottom: 1px solid rgba(11, 94, 66, 0.08);
}

.drawer--left .drawer__nav-link {
  color: var(--tennis-green-dark, #062D20) !important;
  font-size: 16px;
  font-weight: 500;
  padding: 14px 20px;
  display: block;
  transition: background-color 0.2s ease;
}

.drawer--left .drawer__nav-link:hover,
.drawer--left .drawer__nav-link:active {
  background-color: rgba(11, 94, 66, 0.05);
  color: var(--tennis-green, #0B5E42) !important;
}

.drawer--left .drawer__nav-link--active {
  color: var(--tennis-green, #0B5E42) !important;
  font-weight: 700;
  border-left: 3px solid var(--tennis-accent, #F5C518);
}

/* --- Mobile Nav Toggle Button --- */
.mobile-nav-toggle {
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- Touch-Friendly Buttons --- */
@media (hover: none) and (pointer: coarse) {
  .btn,
  .button,
  .product-form__submit,
  .cart__checkout,
  .site-header__icon {
    min-height: 44px;
    min-width: 44px;
  }

  .product-card__quick-add {
    min-height: 44px;
    opacity: 1 !important;
    transform: none !important;
  }

  /* Ensure form inputs are touchable */
  input[type="text"],
  input[type="email"],
  input[type="number"],
  input[type="tel"],
  select,
  textarea {
    min-height: 44px;
    font-size: 16px !important; /* Prevent iOS zoom on focus */
  }
}

/* --- Product Grid Responsive --- */
@media screen and (max-width: 1024px) {
  .grid--uniform .grid__item {
    flex: 0 0 50%;
    max-width: 50%;
  }
}

@media screen and (max-width: 640px) {
  .grid--uniform .grid__item {
    flex: 0 0 100%;
    max-width: 100%;
  }

  /* Single column for very small screens */
  .grid__item .product-card {
    max-width: 100%;
  }
}

/* --- Hero Section Mobile --- */
@media screen and (max-width: 768px) {
  .hero-content {
    padding: 24px 16px !important;
  }

  .hero-headline {
    font-size: 28px !important;
    margin-bottom: 8px !important;
  }

  .hero-subheadline {
    font-size: 16px !important;
    margin-bottom: 20px !important;
  }

  .hero-cta {
    padding: 12px 28px !important;
    font-size: 14px !important;
    width: 100%;
    text-align: center;
    box-sizing: border-box;
  }
}

/* --- Collection Page Mobile --- */
@media screen and (max-width: 768px) {
  .collection-hero__title {
    font-size: 28px !important;
  }

  .collection-hero__description {
    font-size: 14px !important;
  }

  /* Filter toggle button */
  .collection-filters__filter {
    min-height: 44px;
  }

  /* Sort dropdown */
  .collection-filters__sort {
    min-height: 44px;
    font-size: 15px;
  }
}

/* --- Product Page Mobile --- */
@media screen and (max-width: 768px) {
  .product-single__title {
    font-size: 22px !important;
  }

  .product-single__price {
    font-size: 24px !important;
  }

  .product-form__input--pill {
    min-height: 44px;
    min-width: 44px;
  }

  .product-single__description {
    font-size: 15px;
    line-height: 1.6;
  }
}

/* --- Cart Page Mobile --- */
@media screen and (max-width: 768px) {
  .cart__row {
    padding: 12px 0;
  }

  .cart__image-wrapper {
    max-width: 80px;
  }

  .cart__checkout {
    min-height: 48px;
    font-size: 16px;
  }

  .cart__update-button,
  .cart__continue-button {
    min-height: 44px;
    font-size: 14px;
  }

  /* Quantity selector touch-friendly */
  .js-qty__num {
    min-height: 44px;
    font-size: 16px;
  }

  .js-qty__adjust {
    min-height: 44px;
    min-width: 44px;
  }
}

/* --- Footer Mobile --- */
@media screen and (max-width: 768px) {
  .site-footer {
    padding: 32px 16px;
    text-align: center;
  }

  .site-footer__linklist-item {
    padding: 8px 0;
  }

  .site-footer__linklist-item a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .site-footer__newsletter-input {
    min-height: 44px;
    font-size: 15px;
  }
}

/* --- Search Page Mobile --- */
@media screen and (max-width: 768px) {
  .search__input {
    min-height: 44px;
    font-size: 16px;
  }

  .search__button {
    min-height: 44px;
    min-width: 44px;
  }
}

/* --- Account / Login Page Mobile --- */
@media screen and (max-width: 768px) {
  input[type="email"],
  input[type="password"] {
    min-height: 44px;
    font-size: 16px;
  }

  .form-vertical .btn {
    width: 100%;
  }
}

/* --- General Mobile Spacing --- */
@media screen and (max-width: 768px) {
  .page-width {
    padding-left: 16px;
    padding-right: 16px;
  }

  .section-header {
    margin-bottom: 24px;
  }

  .section-header__title {
    font-size: 24px;
  }
}

/* --- Prevent horizontal scroll on mobile --- */
html {
  overflow-x: hidden;
}

body {
  overflow-x: hidden;
  width: 100%;
  position: relative;
}

img,
video,
iframe {
  max-width: 100%;
  height: auto;
}

/* --- Fix Sense theme drawer z-index issues --- */
.drawer {
  z-index: 9999;
}

.drawer__overlay {
  z-index: 9998;
}

</style>

