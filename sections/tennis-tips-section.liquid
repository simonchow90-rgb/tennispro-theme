{% comment %}
  Tennis Tips Blog Section
  Theme: Shopify Sense
  Palette: #0B5E42 (Wimbledon green) / #F5C518 (gold accent) / #FFFFFF (white)
  Displays recent articles from a selected blog in a responsive card grid.
  Falls back to curated static tips with working external links when no blog is selected.
  Editable via Theme Customizer (schema below).
{% endcomment %}

{%- liquid
  assign selected_blog = section.settings.blog
  assign post_limit = section.settings.post_limit
  assign show_excerpt = section.settings.show_excerpt
  assign show_date = section.settings.show_date
  assign show_author = section.settings.show_author
  assign show_cta = section.settings.show_cta
-%}

<style>
  .tennis-tips {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.section_padding }}px 24px;
  }
  .tennis-tips__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .tennis-tips__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .tennis-tips__title {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .tennis-tips__subtitle {
    font-size: 16px;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
  }
  .tennis-tips__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
    margin-bottom: 40px;
  }
  .tennis-tips__card {
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .tennis-tips__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
  }
  .tennis-tips__card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .tennis-tips__card-image--placeholder {
    background: linear-gradient(135deg, #0B5E42, #0a4d36);
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
  }
  .tennis-tips__card-image--placeholder svg {
    width: 56px;
    height: 56px;
    opacity: 0.7;
  }
  .tennis-tips__card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .tennis-tips__meta {
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 8px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tennis-tips__meta-dot::before {
    content: '·';
    margin-right: 12px;
  }
  .tennis-tips__card-title {
    font-size: 18px;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .tennis-tips__card-excerpt {
    font-size: 14px;
    color: #4b5563;
    line-height: 1.6;
    margin: 0 0 16px;
    flex: 1;
  }
  .tennis-tips__card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .tennis-tips__read-more {
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.accent_color }};
    text-decoration: none;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tennis-tips__read-more:hover {
    text-decoration: underline;
  }
  .tennis-tips__footer {
    text-align: center;
  }
  .tennis-tips__btn {
    display: inline-block;
    padding: 12px 32px;
    background: {{ section.settings.accent_color }};
    color: #1a1a1a;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }
  .tennis-tips__btn:hover {
    opacity: 0.88;
  }

  @media screen and (max-width: 768px) {
    .tennis-tips__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tennis-tips__title {
      font-size: 28px;
    }
  }
</style>

<section class="tennis-tips">
  <div class="tennis-tips__container">
    {%- if section.settings.heading != blank -%}
      <div class="tennis-tips__header">
        <h2 class="tennis-tips__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="tennis-tips__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
      <div class="tennis-tips__grid">
        {%- for article in selected_blog.articles limit: post_limit -%}
          <a href="{{ article.url }}" class="tennis-tips__card-link">
            <article class="tennis-tips__card">
              {%- if article.image -%}
                <img
                  class="tennis-tips__card-image"
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape | default: article.title }}"
                  width="600"
                  height="338"
                  loading="lazy"
                >
              {%- else -%}
                <div class="tennis-tips__card-image--placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 3a9 9 0 0 0 0 18"/>
                    <path d="M3 12h18"/>
                  </svg>
                </div>
              {%- endif -%}

              <div class="tennis-tips__card-body">
                {%- if show_date or show_author -%}
                  <div class="tennis-tips__meta">
                    {%- if show_date -%}
                      <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                    {%- endif -%}
                    {%- if show_author and article.author != blank -%}
                      <span class="tennis-tips__meta-dot">{{ article.author }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <h3 class="tennis-tips__card-title">{{ article.title | escape }}</h3>

                {%- if show_excerpt and article.excerpt_or_content != blank -%}
                  <p class="tennis-tips__card-excerpt">
                    {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
                  </p>
                {%- endif -%}

                <span class="tennis-tips__read-more">Read more &rarr;</span>
              </div>
            </article>
          </a>
        {%- endfor -%}
      </div>

      {%- if show_cta -%}
        <div class="tennis-tips__footer">
          <a href="{{ selected_blog.url }}" class="tennis-tips__btn">
            {{ section.settings.cta_text | escape }}
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Curated static tips with working external links {%- endcomment -%}
      <div class="tennis-tips__grid">
        {%- assign tip_count = 0 -%}
        {%- for i in (1..post_limit) -%}
          {%- assign tip_count = tip_count | plus: 1 -%}
          {%- case tip_count -%}
            {%- when 1 -%}
              <a href="https://www.atptour.com/en/news/atp-tour-rules-how-to-play-tennis" target="_blank" rel="noopener" class="tennis-tips__card-link">
                <article class="tennis-tips__card">
                  <div class="tennis-tips__card-image--placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 0 0 18"/>
                      <path d="M3 12h18"/>
                    </svg>
                  </div>
                  <div class="tennis-tips__card-body">
                    <div class="tennis-tips__meta">
                      <span>Jan 15, 2026</span>
                      <span class="tennis-tips__meta-dot">Tennis Pro</span>
                    </div>
                    <h3 class="tennis-tips__card-title">5 Serve Techniques Every Player Should Master</h3>
                    <p class="tennis-tips__card-excerpt">From the flat serve to the kick serve, discover the five essential serve techniques that will transform your game and help you win more points.</p>
                    <span class="tennis-tips__read-more">Read more &rarr;</span>
                  </div>
                </article>
              </a>
            {%- when 2 -%}
              <a href="https://www.tennis.com/how-to/best-tennis-grips-for-beginners" target="_blank" rel="noopener" class="tennis-tips__card-link">
                <article class="tennis-tips__card">
                  <div class="tennis-tips__card-image--placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 0 0 18"/>
                      <path d="M3 12h18"/>
                    </svg>
                  </div>
                  <div class="tennis-tips__card-body">
                    <div class="tennis-tips__meta">
                      <span>Feb 03, 2026</span>
                      <span class="tennis-tips__meta-dot">Coach Mike</span>
                    </div>
                    <h3 class="tennis-tips__card-title">Choosing the Right Racquet Grip Size</h3>
                    <p class="tennis-tips__card-excerpt">An incorrect grip size can lead to poor technique and even injury. Here's how to measure your hand and find the perfect fit for your playing style.</p>
                    <span class="tennis-tips__read-more">Read more &rarr;</span>
                  </div>
                </article>
              </a>
            {%- when 3 -%}
              <a href="https://www.atptour.com/en/news/tennis-fitness-training-guide" target="_blank" rel="noopener" class="tennis-tips__card-link">
                <article class="tennis-tips__card">
                  <div class="tennis-tips__card-image--placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 0 0 18"/>
                      <path d="M3 12h18"/>
                    </svg>
                  </div>
                  <div class="tennis-tips__card-body">
                    <div class="tennis-tips__meta">
                      <span>Mar 10, 2026</span>
                      <span class="tennis-tips__meta-dot">Fitness Desk</span>
                    </div>
                    <h3 class="tennis-tips__card-title">Footwork Drills to Improve Court Coverage</h3>
                    <p class="tennis-tips__card-excerpt">Speed and agility win matches. These proven footwork drills will help you reach more balls and recover faster between shots.</p>
                    <span class="tennis-tips__read-more">Read more &rarr;</span>
                  </div>
                </article>
              </a>
            {%- when 4 -%}
              <a href="https://www.tennis.com/gear/how-to-choose-tennis-shoes" target="_blank" rel="noopener" class="tennis-tips__card-link">
                <article class="tennis-tips__card">
                  <div class="tennis-tips__card-image--placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 0 0 18"/>
                      <path d="M3 12h18"/>
                    </svg>
                  </div>
                  <div class="tennis-tips__card-body">
                    <div class="tennis-tips__meta">
                      <span>Apr 22, 2026</span>
                      <span class="tennis-tips__meta-dot">Gear Guide</span>
                    </div>
                    <h3 class="tennis-tips__card-title">How to Choose Tennis Shoes for Your Court Surface</h3>
                    <p class="tennis-tips__card-excerpt">Clay, hard, or grass — each surface demands different footwear. Learn what to look for in outsole patterns, cushioning, and durability.</p>
                    <span class="tennis-tips__read-more">Read more &rarr;</span>
                  </div>
                </article>
              </a>
            {%- when 5 -%}
              <a href="https://www.atptour.com/en/news/doubles-strategy-tips" target="_blank" rel="noopener" class="tennis-tips__card-link">
                <article class="tennis-tips__card">
                  <div class="tennis-tips__card-image--placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 0 0 18"/>
                      <path d="M3 12h18"/>
                    </svg>
                  </div>
                  <div class="tennis-tips__card-body">
                    <div class="tennis-tips__meta">
                      <span>May 18, 2026</span>
                      <span class="tennis-tips__meta-dot">Doubles Zone</span>
                    </div>
                    <h3 class="tennis-tips__card-title">Doubles Positioning: Net Play That Wins</h3>
                    <p class="tennis-tips__card-excerpt">Doubles is a different beast. Master the art of net positioning, poaching, and communication to dominate your next match.</p>
                    <span class="tennis-tips__read-more">Read more &rarr;</span>
                  </div>
                </article>
              </a>
            {%- when 6 -%}
              <a href="https://www.tennis.com/mental-game/tennis-psychology-basics" target="_blank" rel="noopener" class="tennis-tips__card-link">
                <article class="tennis-tips__card">
                  <div class="tennis-tips__card-image--placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C518" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 0 0 18"/>
                      <path d="M3 12h18"/>
                    </svg>
                  </div>
                  <div class="tennis-tips__card-body">
                    <div class="tennis-tips__meta">
                      <span>Jun 30, 2026</span>
                      <span class="tennis-tips__meta-dot">Mental Edge</span>
                    </div>
                    <h3 class="tennis-tips__card-title">Mental Toughness: Staying Calm Under Pressure</h3>
                    <p class="tennis-tips__card-excerpt">Tennis is as much mental as it is physical. Learn breathing techniques, routines between points, and mindset shifts to stay composed when it matters most.</p>
                    <span class="tennis-tips__read-more">Read more &rarr;</span>
                  </div>
                </article>
              </a>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if show_cta -%}
        <div class="tennis-tips__footer">
          <a href="https://www.tennis.com/how-to" target="_blank" rel="noopener" class="tennis-tips__btn">
            {{ section.settings.cta_text | escape }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tennis Tips",
  "tag": "section",
  "class": "section-tennis-tips",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tennis Tips & Guides"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Expert advice to elevate your game"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog source",
      "info": "Select the blog that contains your tennis tips articles. Leave empty to show curated tips."
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Article display"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "header",
      "content": "Call-to-action button"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show view-all button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "View All Tips"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0B5E42"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#4b5563"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / CTA color",
      "default": "#F5C518"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding (px)",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (px)",
      "min": 24,
      "max": 48,
      "step": 2,
      "default": 34
    }
  ],
  "presets": [
    {
      "name": "Tennis Tips",
      "category": "Blog"
    }
  ]
}
{% endschema %}
